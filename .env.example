# Kopiera till .env och fyll i. .env committas aldrig (se .gitignore).
# Lokalt behövs ingenting här: nycklarna hämtas från "npx supabase status".
# Ägaren fyller i värdena själv när molnkontona finns (docs/faser/fas-2-plan.md, avsnitt C).

# Supabase, projektet i molnet (region Stockholm, eu-north-1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bara för server och skript. Får aldrig hamna i klienten eller i loggar.
SUPABASE_SERVICE_ROLE_KEY=

# E-posttjänst för inloggningsmejl (SMTP), läggs in i Supabase under Authentication, SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_AVSANDARE=

# Plattformens adress (inloggningslänkarna går hit)
SITE_URL=

# Plattformens bygge (apps/platform). Bara den publika nyckeln, aldrig service-nyckeln.
# Lokalt skrivs apps/platform/.env.local av npm run plattform:env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Adresser som får anropa serverfunktionerna (CORS), kommaseparerade. Sätts i Supabase Secrets.
PLATTFORM_URL=

# Assistenten (chatten). Sätts som Secrets för Edge Functions i Supabase, aldrig i klienten.
# Utan ANTHROPIC_API_KEY och ASSISTENT_MODELL är assistenten avstängd (docs/assistent.md).
ANTHROPIC_API_KEY=
ASSISTENT_MODELL=claude-opus-5-5
# low, medium eller high. Standard medium.
ASSISTENT_INSATS=

# Felloggning (fas 2f). Bara Sentrys EU-region (…@oNNN.ingest.de.sentry.io/NNN). Tomt = avstängd.
# SENTRY_DSN och FLODIA_MILJO sätts som Secrets för Edge Functions i Supabase.
SENTRY_DSN=
FLODIA_MILJO=
# Samma DSN för plattformens bygge (publik, bara för att skicka fel).
VITE_SENTRY_DSN=
VITE_FLODIA_MILJO=
